{
  "name": "nestcut",
  "version": "0.1.0",
  "private": true,
  "description": "NestCut offline print and cut layout desktop app",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "desktop:start": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3"
  }
}
